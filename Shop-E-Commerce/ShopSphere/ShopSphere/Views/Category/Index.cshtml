@model IEnumerable<ShopSphere.DatabaseModels.Category>

@{
    ViewData["Title"] = "Categories";

    var role = Context.Session.GetString("UserRole") ?? "";
    bool isAdmin = role.Equals("Admin", StringComparison.OrdinalIgnoreCase);
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Categories</h2>

        @if (isAdmin)
        {
            <a asp-action="Create" class="btn btn-success">
                + Add Category
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No categories available.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var item in Model)
            {
                <div class="col-6 col-md-3 col-lg-2 mb-4">

                    <div class="card h-100 shadow-sm text-center border-0 category-card">

                        <div class="card-body">

                            <div style="font-size:40px;">🛍️</div>

                            <h6 class="fw-bold">
                                @item.CategoryName
                            </h6>

                            <!-- USER ACTION -->
                            <a asp-controller="Products"
                               asp-action="Index"
                               asp-route-categoryId="@item.CategoryId"
                               class="btn btn-sm btn-primary mt-2 w-100">
                                Shop Now
                            </a>

                            <!-- ADMIN ACTIONS -->
                            @if (isAdmin)
                            {
                                <a asp-action="Delete"
                                   asp-route-id="@item.CategoryId"
                                   class="btn btn-sm btn-danger mt-2 w-100">
                                    Delete
                                </a>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>