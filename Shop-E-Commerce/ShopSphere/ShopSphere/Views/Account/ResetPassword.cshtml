@{
    ViewData["Title"] = "Reset Password";
}

<h3>Reset Password</h3>

<form method="post">
    <div class="mb-3">
        <label>New Password</label>
        <input type="password" name="newPassword" class="form-control" required />
    </div>

    <button class="btn btn-danger">Reset Password</button>
</form>
