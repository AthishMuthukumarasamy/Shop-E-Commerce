@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">

    <h2 class="mb-4 fw-bold">Admin Dashboard</h2>

    <div class="row g-3">

        <div class="col-md-4">
            <div class="card shadow border-primary">
                <div class="card-body text-center">
                    <h4>Products</h4>
                    <p class="text-muted">Manage all products</p>

                    <a asp-action="Products" class="btn btn-primary">
                        View Products
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow border-success">
                <div class="card-body text-center">
                    <h4>Add Product</h4>
                    <p class="text-muted">Create new product</p>

                    <a asp-action="AddProduct" class="btn btn-success">
                        Add Product
                    </a>
                </div>
            </div>
        </div>

    </div>

</div>