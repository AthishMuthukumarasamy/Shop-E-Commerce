@model ShopSphere.DatabaseModels.Product

@{
    ViewData["Title"] = "Add Product";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-success text-white">
            <h4>Add Product</h4>
        </div>

        <div class="card-body">

            <form asp-action="AddProduct" method="post" enctype="multipart/form-data">

                <div class="mb-2">
                    <label>Product Name</label>
                    <input asp-for="ProductName" class="form-control" />
                </div>

                <div class="mb-2">
                    <label>Description</label>
                    <textarea asp-for="Description" class="form-control"></textarea>
                </div>

                <div class="mb-2">
                    <label>Price</label>
                    <input asp-for="Price" class="form-control" />
                </div>

                <div class="mb-2">
                    <label>Stock</label>
                    <input asp-for="Stock" class="form-control" />
                </div>

                <div class="mb-2">
                    <label>Category</label>
                    <select asp-for="CategoryId" class="form-control">
                        @foreach (var c in ViewBag.Categories)
                        {
                            <option value="@c.CategoryId">@c.CategoryName</option>
                        }
                    </select>
                </div>

                <div class="mb-2">
                    <label>Brand</label>
                    <select asp-for="BrandId" class="form-control">
                        @foreach (var b in ViewBag.Brands)
                        {
                            <option value="@b.BrandId">@b.BrandName</option>
                        }
                    </select>
                </div>

                <input asp-for="RetailerId" type="hidden" value="1" />

                <!-- default values -->
                <input asp-for="Status" type="hidden" value="Pending" />
                <input asp-for="IsActive" type="hidden" value="true" />

                <div class="mb-2">
                    <label>Product Image</label>
                    <input type="file" name="productImage" class="form-control" accept=".jpg,.jpeg,.png" />
                </div>

                <button type="submit" class="btn btn-success mt-3">
                    Save
                </button>

            </form>

        </div>

    </div>

</div>