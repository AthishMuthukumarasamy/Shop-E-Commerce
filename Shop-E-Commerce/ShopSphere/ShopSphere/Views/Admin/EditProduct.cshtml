@model ShopSphere.DatabaseModels.Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-warning text-white">
            <h4>Edit Product</h4>
        </div>

        <div class="card-body">

            <form asp-action="EditProduct" asp-controller="Admin" method="post">

                <!-- IMPORTANT: ID -->
                <input type="hidden" asp-for="ProductId" />

                <!-- OPTIONAL: Status -->
                <input type="hidden" asp-for="Status" />

                <!-- Product Name -->
                <div class="mb-3">
                    <label class="form-label">Product Name</label>
                    <input asp-for="ProductName" class="form-control" />
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control"></textarea>
                </div>

                <!-- Price -->
                <div class="mb-3">
                    <label class="form-label">Price</label>
                    <input asp-for="Price" class="form-control" />
                </div>

                <!-- Stock -->
                <div class="mb-3">
                    <label class="form-label">Stock</label>
                    <input asp-for="Stock" class="form-control" />
                </div>

                <!-- CATEGORY (FIX FOR INVALID CATEGORY ERROR) -->
                <div class="mb-3">
                    <label class="form-label">Category</label>
                    <select asp-for="CategoryId" class="form-control"
                            asp-items="@(new SelectList(ViewBag.Categories, "CategoryId", "CategoryName"))">
                        <option value="">-- Select Category --</option>
                    </select>
                </div>

                <!-- BRAND -->
                <div class="mb-3">
                    <label class="form-label">Brand</label>
                    <select asp-for="BrandId" class="form-control"
                            asp-items="@(new SelectList(ViewBag.Brands, "BrandId", "BrandName"))">
                        <option value="">-- Select Brand --</option>
                    </select>
                </div>

                <!-- SUBMIT -->
                <button type="submit" class="btn btn-warning text-white">
                    Update Product
                </button>

            </form>

        </div>
    </div>
</div>