@{
    ViewData["Title"] = "Retailer Dashboard";
}

<div class="container mt-4">

    <h2>Retailer Dashboard</h2>

    <div class="row mt-4">

        <div class="col-md-4">
            <div class="card shadow p-3">
                <h5>Total Products</h5>
                <h3>@ViewBag.TotalProducts</h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow p-3">
                <h5>Pending</h5>
                <h3 class="text-warning">@ViewBag.PendingProducts</h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow p-3">
                <h5>Approved</h5>
                <h3 class="text-success">@ViewBag.ApprovedProducts</h3>
            </div>
        </div>

    </div>

    <a asp-action="MyProducts" class="btn btn-primary mt-4">
        View My Products
    </a>

</div>