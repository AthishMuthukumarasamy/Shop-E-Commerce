@model ShopSphere.DatabaseModels.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h3>Product Details</h3>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-12">

                    <table class="table table-bordered">

                        <tr>
                            <th width="250">Product ID</th>
                            <td>@Model.ProductId</td>
                        </tr>

                        <tr>
                            <th>Product Name</th>
                            <td>@Model.ProductName</td>
                        </tr>

                        <tr>
                            <th>Description</th>
                            <td>@Model.Description</td>
                        </tr>

                        <tr>
                            <th>Category</th>
                            <td>@Model.Category?.CategoryName</td>
                        </tr>

                        <tr>
                            <th>Brand</th>
                            <td>@Model.Brand?.BrandName</td>
                        </tr>

                        <tr>
                            <th>Price</th>
                            <td>₹@Model.Price</td>
                        </tr>

                        <tr>
                            <th>Stock</th>
                            <td>@Model.Stock</td>
                        </tr>

                        <tr>
                            <th>Status</th>
                            <td>@Model.Status</td>
                        </tr>

                        <tr>
                            <th>Active</th>
                            <td>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Inactive
                                    </span>
                                }
                            </td>
                        </tr>

                        <tr>
                            <th>Retailer</th>
                            <td>@Model.Retailer?.Name</td>
                        </tr>

                        <tr>
                            <th>Created Date</th>
                            <td>
                                @(Model.CreatedDate?.ToString("dd-MMM-yyyy"))
                            </td>
                        </tr>

                    </table>

                </div>

            </div>

            <div class="mt-3">

                <a asp-action="EditProduct"
                   asp-route-id="@Model.ProductId"
                   class="btn btn-warning">
                    Edit
                </a>

                <a asp-action="Products"
                   class="btn btn-secondary">
                    Back to List
                </a>

            </div>

        </div>

    </div>

</div>