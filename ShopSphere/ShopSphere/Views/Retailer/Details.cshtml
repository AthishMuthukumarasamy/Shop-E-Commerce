@model ShopSphere.DatabaseModels.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="container mt-4">

    <h2>Product Details</h2>

    <table class="table table-bordered">

        <tr><th>Name</th><td>@Model.ProductName</td></tr>
        <tr><th>Description</th><td>@Model.Description</td></tr>
        <tr><th>Price</th><td>₹@Model.Price</td></tr>
        <tr><th>Stock</th><td>@Model.Stock</td></tr>
        <tr><th>Category</th><td>@Model.Category?.CategoryName</td></tr>
        <tr><th>Brand</th><td>@Model.Brand?.BrandName</td></tr>
        <tr><th>Status</th><td>@Model.Status</td></tr>

    </table>

    <a asp-action="MyProducts" class="btn btn-secondary">Back</a>

</div>