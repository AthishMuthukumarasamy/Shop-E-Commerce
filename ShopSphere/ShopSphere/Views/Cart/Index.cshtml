@model ShopSphere.DatabaseModels.Cart

@{
    ViewData["Title"] = "My Cart";
    decimal grandTotal = 0;
}

<div class="container mt-4">

    <div class="row mb-3">
        <div class="col-md-12">
            <h2 class="text-primary">
                <i class="fas fa-shopping-cart"></i> Shopping Cart
            </h2>
            <hr />
        </div>
    </div>

    @if (Model == null || Model.CartItems == null || !Model.CartItems.Any())
    {
        <div class="alert alert-info text-center">
            <h4>Your cart is empty</h4>
            <p>Browse products and add items to your cart.</p>

            <a asp-controller="Product"
               asp-action="Index"
               class="btn btn-primary">
                Continue Shopping
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Image</th>
                        <th>Product</th>
                        <th>Price</th>
                        <th width="180">Quantity</th>
                        <th>Total</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.CartItems)
                    {
                        decimal total = item.Quantity * item.UnitPrice;
                        grandTotal += total;

                        <tr>
                            <td width="120">
                                @{
                                    var image = item.Product.ProductImages
                                        .FirstOrDefault(x => x.IsPrimary == true)
                                        ?? item.Product.ProductImages.FirstOrDefault();
                                }

                                @if (image != null && !string.IsNullOrEmpty(image.ImageUrl))
                                {
                                    <img src="@image.ImageUrl"
                                         class="img-fluid rounded"
                                         style="height:80px;width:80px;object-fit:cover;" />
                                }
                                else
                                {
                                    <img src="/images/no-image.png"
                                         class="img-fluid rounded"
                                         style="height:80px;width:80px;object-fit:cover;" />
                                }
                            </td>

                            <td>
                                <strong>@item.Product.ProductName</strong>
                                <br />
                                <small class="text-muted">
                                    @item.Product.Description
                                </small>
                            </td>

                            <td>
                                ₹@item.UnitPrice.ToString("N2")
                            </td>

                            <td>

                                <div class="d-flex justify-content-center align-items-center">

                                    <a asp-action="Decrease"
                                       asp-route-id="@item.CartItemId"
                                       class="btn btn-danger btn-sm">
                                        -
                                    </a>

                                    <span class="mx-3 fw-bold">
                                        @item.Quantity
                                    </span>

                                    <a asp-action="Increase"
                                       asp-route-id="@item.CartItemId"
                                       class="btn btn-success btn-sm">
                                        +
                                    </a>

                                </div>

                            </td>

                            <td>
                                ₹@total.ToString("N2")
                            </td>

                            <td>
                                <a asp-action="Remove"
                                   asp-route-id="@item.CartItemId"
                                   class="btn btn-outline-danger btn-sm"
                                   onclick="return confirm('Remove this item from cart?')">
                                    Remove
                                </a>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="row mt-4">

            <div class="col-md-6">
                <a asp-controller="Product"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Continue Shopping
                </a>
            </div>

            <div class="col-md-6 text-end">

                <div class="card shadow-sm">
                    <div class="card-body">

                        <h4>
                            Grand Total :
                            <span class="text-success">
                                ₹@grandTotal.ToString("N2")
                            </span>
                        </h4>

                        <a asp-controller="Order"
                           asp-action="Checkout"
                           class="btn btn-primary btn-lg mt-2">
                            Proceed to Checkout
                        </a>

                    </div>
                </div>

            </div>

        </div>
    }

</div>