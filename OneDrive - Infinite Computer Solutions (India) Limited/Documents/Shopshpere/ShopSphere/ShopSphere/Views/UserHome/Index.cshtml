@{
    ViewData["Title"] = "User Dashboard";
}

<div class="container mt-4">

    <div class="card shadow p-4">

        <h3>Welcome, @Context.Session.GetString("UserName") </h3>

        <p class="text-muted">
            Manage your shopping activity from here.
        </p>

    </div>

    <div class="row mt-4">

        <div class="col-md-3">
            <div class="card p-3 text-center shadow">
                <h5>Profile</h5>
                <a asp-action="Profile" class="btn btn-primary mt-2">View</a>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 text-center shadow">
                <h5>Orders</h5>
                <a asp-controller="Order" asp-action="MyOrders" class="btn btn-success mt-2">
                    View
                </a>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 text-center shadow">
                <h5>Wishlist</h5>
                <a asp-controller="Wishlist" asp-action="Index" class="btn btn-warning mt-2">
                    Open
                </a>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card p-3 text-center shadow">
                <h5>Compare</h5>
                <a asp-controller="Compare" asp-action="Index" class="btn btn-info mt-2">
                    Compare
                </a>
            </div>
        </div>

    </div>

</div>