@model IEnumerable<ShopSphere.DatabaseModels.CompareProduct>

@{
    ViewData["Title"] = "Compare Products";
}

<div class="container mt-4">

    <h2 class="mb-4">Compare Products</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No products added for comparison.
        </div>
    }
    else
    {
        <table class="table table-bordered">

            <thead class="table-dark">
                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Category</th>
                    <th>Brand</th>
                    <th>Added Date</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            @item.Product?.ProductName
                        </td>

                        <td>
                            ₹@item.Product?.Price
                        </td>

                        <td>
                            @item.Product?.Category?.CategoryName
                        </td>

                        <td>
                            @item.Product?.Brand?.BrandName
                        </td>

                        <td>
                            @(item.AddedDate?.ToString("dd MMM yyyy"))
                        </td>

                        <td>

                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@item.ProductId"
                               class="btn btn-primary btn-sm">
                                View
                            </a>

                            <a asp-action="Remove"
                               asp-route-id="@item.CompareId"
                               class="btn btn-danger btn-sm">
                                Remove
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }

</div>